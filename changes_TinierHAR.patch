+        x = x[:, -1, :]
+        return self.fc(x)
+
+    def number_of_parameters(self):
+        return sum(p.numel() for p in self.parameters() if p.requires_grad)
+
+
+class DeepConvLSTM_NoLSTM(nn.Module):
+    def __init__(self, input_shape, nb_classes, filter_scaling_factor, config):
+        super().__init__()
+        self.nb_filters = int(config["filter_scaling_factor"]*config["nb_filters"])
+        self.nb_channels = input_shape[3]
+        
+        self.conv_blocks = nn.ModuleList([
+            ConvBlock(config["filter_width"], input_shape[1] if i == 0 else self.nb_filters, 
+                      self.nb_filters, config["dilation"], bool(config["batch_norm"]))
+            for i in range(config["nb_conv_blocks"])
+        ])
+        self.dropout = nn.Dropout(config["drop_prob"])
+        self.fc = nn.Linear(self.nb_filters * self.nb_channels, nb_classes)
+
+    def forward(self, x):
+        for conv_block in self.conv_blocks:
+            x = conv_block(x)
+        x = x.permute(0, 2, 1, 3).reshape(-1, x.shape[2], self.nb_filters * self.nb_channels)
+        x = self.dropout(x)
+        x = x[:, -1, :] 
+        return self.fc(x)
+
+    def number_of_parameters(self):
         return sum(p.numel() for p in self.parameters() if p.requires_grad)
