     def number_of_parameters(self):
         return sum(p.numel() for p in self.parameters() if p.requires_grad)
 
+class TinierHAR_NoConv(nn.Module):
+    def __init__(self, input_shape, nb_classes, filter_scaling_factor, config):
+        super().__init__()
+        self.input_channels = input_shape[3]
+        self.nb_units_gru = config["nb_units_gru"]
+
+        self.gru = nn.GRU(input_size=self.input_channels, hidden_size=self.nb_units_gru, bidirectional=True, batch_first=True)
+        self.attention = nn.Linear(2*self.nb_units_gru, 1)
+        self.classifier = nn.Sequential(nn.Linear(2*self.nb_units_gru, nb_classes))
+        self.dropout = nn.Dropout(config["drop_prob"])
+
+    def forward(self, x):
+        x = x.squeeze(1) 
+        x = self.dropout(x)
+        x, _ = self.gru(x)
+        attn_weights = torch.softmax(self.attention(x), dim=1)
+        x = torch.sum(attn_weights * x, dim=1)
+        return self.classifier(x)
+
+    def number_of_parameters(self):
+        return sum(p.numel() for p in self.parameters() if p.requires_grad)
+
+class TinierHAR_NoShortcut(TinierHAR_Model):
+    def __init__(self, input_shape, nb_classes, filter_scaling_factor, config):
+        super().__init__(input_shape, nb_classes, filter_scaling_factor, config)
+        conv_blocks = [
+            ConvBlock(1, self.nb_filters, 5, 1, use_maxpool=True, shortcut=False),
+            ConvBlock(self.nb_filters, 2*self.nb_filters, 5, 1, use_maxpool=True, shortcut=False)
+        ]
+        for _ in range(self.nb_conv_blocks):
+            conv_blocks.append(ConvBlock(2*self.nb_filters, 2*self.nb_filters, 5, 1, use_maxpool=False, shortcut=False))
+        self.conv_blocks = nn.Sequential(*conv_blocks)
+
+class TinierHAR_NoGRU(nn.Module):
+    def __init__(self, input_shape, nb_classes, filter_scaling_factor, config):
+        super().__init__()
+        self.input_channels = input_shape[3]
+        self.seq_length = input_shape[2]
+        self.nb_filters = config["nb_filters"]
+        
+        conv_blocks = [
+            ConvBlock(1, self.nb_filters, 5, 1, use_maxpool=True, shortcut=True),
+            ConvBlock(self.nb_filters, 2*self.nb_filters, 5, 1, use_maxpool=True, shortcut=True)
+        ]
+        for _ in range(config["nb_conv_blocks"]):
+            conv_blocks.append(ConvBlock(2*self.nb_filters, 2*self.nb_filters, 5, 1, use_maxpool=False, shortcut=True))
+        self.conv_blocks = nn.Sequential(*conv_blocks)
+
+        with torch.no_grad():
+            dummy = torch.randn(1, 1, self.seq_length, self.input_channels)
+            gru_input_dim = self.conv_blocks(dummy).size(1) * self.conv_blocks(dummy).size(3)
+
+        self.attention = nn.Linear(gru_input_dim, 1)
+        self.classifier = nn.Sequential(nn.Linear(gru_input_dim, nb_classes))
+        self.dropout = nn.Dropout(config["drop_prob"])
+
+    def forward(self, x):
+        x = self.conv_blocks(x)
+        x = x.permute(0, 2, 1, 3).reshape(x.shape[0], x.shape[2], -1)
+        x = self.dropout(x)
+        attn_weights = torch.softmax(self.attention(x), dim=1)
+        x = torch.sum(attn_weights * x, dim=1)
+        return self.classifier(x)
+
+    def number_of_parameters(self):
+        return sum(p.numel() for p in self.parameters() if p.requires_grad)
+
+class TinierHAR_NoAgg(TinierHAR_Model):
+    def forward(self, x):
+        x = self.conv_blocks(x)
+        x = x.permute(0, 2, 1, 3).reshape(x.shape[0], x.shape[2], -1)
+        x = self.dropout(x)
+        x, _ = self.gru(x)
+        x = x[:, -1, :]
+        return self.classifier(x)
